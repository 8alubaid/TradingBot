# --- Anthropic / Claude Agent SDK ---
ANTHROPIC_API_KEY=

# --- Alpaca ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Safety gate: BOTH must be flipped to trade with real money. Default is paper-only.
ALPACA_PAPER=true
I_UNDERSTAND_LIVE_TRADING=false

# --- Webhook (TradingView -> this server) ---
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-string
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# --- Notifications ---
# whatsapp | telegram
NOTIFIER_BACKEND=whatsapp

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your personal number in E.164 format, e.g. +15551234567
NOTIFY_WHATSAPP_TO=

# Telegram fallback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk manager defaults ---
MAX_POSITION_PCT_OF_EQUITY=0.05
DAILY_LOSS_LIMIT_PCT=0.03
MAX_OPEN_POSITIONS=3
# Must match symbols actually tradable on Alpaca -- verify with core.execution.get_tradable_crypto_symbols()
SYMBOL_ALLOWLIST=BTC/USD,ETH/USD,XRP/USD,DOGE/USD,SOL/USD
SYMBOL_COOLDOWN_SECONDS=300

# --- Storage ---
DATABASE_PATH=data/trades.db
LOCAL_LESSONS_DIR=lessons
# Leave blank to skip GCS upload (local-only dev)
GCS_BUCKET_NAME=
GCP_PROJECT_ID=

# --- Events (Pub/Sub) -- only active when GCP_PROJECT_ID is set and the topic exists ---
PUBSUB_EVENTS_TOPIC=trading-bot-events

# --- Autonomous scanner -- trades on its own EMA/RSI signal, no TradingView alert needed ---
AUTONOMOUS_SCANNING_ENABLED=true
SCAN_INTERVAL_MINUTES=5
# Bar size for the EMA/RSI calc. Lower = crosses fire more often but are less
# meaningful (good for a quick demo); 15 is a more realistic default.
SCAN_BAR_TIMEFRAME_MINUTES=15
